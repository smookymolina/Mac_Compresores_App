// MAC Compresores — esquema relacional del MVP.
// Dinero: Decimal(14,2); costos y tasas con más precisión. Nunca Float.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Identidad y autorización ─────────

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // ADMIN | VENTAS | ALMACEN | GERENCIA
  name        String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique
  name           String
  passwordHash   String
  roleId         String               @db.Uuid
  role           Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sessions       Session[]
  passwordResets PasswordResetToken[]

  customers         Customer[]
  quotes            Quote[]             @relation("QuoteSeller")
  sales             Sale[]              @relation("SaleSeller")
  movements         InventoryMovement[]
  auditLogs         AuditLog[]
  commissionEntries CommissionEntry[]
  salesTargets      SalesTarget[]
}

model Session {
  id        String   @id // SHA-256 del token; el token en claro solo vive en la cookie
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Token de un solo uso para restablecer la contraseña; el token en claro solo viaja en el correo.
model PasswordResetToken {
  id        String    @id // SHA-256 del token
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────── Catálogo ─────────

/// Línea comercial: determina la tasa de comisión.
enum ProductLine {
  EQUIPO_VENTA // Venta de equipos nuevos o usados
  RENTA // Renta de equipos
  REFACCIONES // Filtros, separadores, drenes, lubricantes
  TUBERIA // Tubería e instalaciones neumáticas
  SERVICIOS // Servicios de pistón o tornillo
  KITS // Kits para compresores tipo tornillo
  VALVULAS_OTROS // Válvulas de seguridad, poleas, bandas, conexiones
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  products Product[]
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  sku           String        @unique
  oemName       String?
  oemPartNumber String?
  supplierCode  String? // "Item #" / "Air Supply Number"
  description   String
  categoryId    String?       @db.Uuid
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  line          ProductLine
  kind          ProductKind   @default(PRODUCT)
  unit          String        @default("PZA")
  cost          Decimal       @default(0) @db.Decimal(14, 4)
  markup        Decimal       @default(0) @db.Decimal(8, 4) // "Utilidad" (fracción)
  shipping      Decimal       @default(0) @db.Decimal(14, 2) // "Envío"
  price         Decimal       @default(0) @db.Decimal(14, 2)
  taxRate       Decimal       @default(0.16) @db.Decimal(5, 4)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  priceHistory PriceHistory[]
  balances     StockBalance[]
  movements    InventoryMovement[]
  quoteItems   QuoteItem[]
  saleItems    SaleItem[]

  @@index([description])
  @@index([oemPartNumber])
  @@index([line])
}

model PriceHistory {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cost        Decimal  @db.Decimal(14, 4)
  price       Decimal  @db.Decimal(14, 2)
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

// ───────── Clientes ─────────

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  legalName        String
  rfc              String?  @unique
  email            String?
  phone            String?
  paymentTermsDays Int      @default(0)
  creditLimit      Decimal? @db.Decimal(14, 2)
  notes            String?
  active           Boolean  @default(true)
  ownerId          String?  @db.Uuid // vendedor asignado
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts  CustomerContact[]
  addresses CustomerAddress[]
  quotes    Quote[]
  sales     Sale[]

  @@index([legalName])
  @@index([ownerId])
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  email      String?
  phone      String?
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Principal")
  street     String
  city       String?
  state      String?
  zip        String?
}

// ───────── Inventario ─────────

model Warehouse {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique
  name      String
  active    Boolean             @default(true)
  balances  StockBalance[]
  movements InventoryMovement[]
  sales     Sale[]
}

enum MovementType {
  IN
  OUT
  ADJUST
  SALE_OUT
  REVERSAL
}

/// Inmutable. Las correcciones se hacen con un movimiento REVERSAL que apunta al original.
model InventoryMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String       @db.Uuid
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  type        MovementType
  quantity    Decimal      @db.Decimal(14, 3) // con signo
  reason      String
  refType     String? // "SALE"
  refId       String?      @db.Uuid
  reversesId  String?      @unique @db.Uuid // a lo sumo una reversa por movimiento
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([productId, warehouseId, createdAt])
  @@index([refType, refId])
}

/// Saldo materializado; se actualiza en la misma transacción que el movimiento.
model StockBalance {
  productId   String    @db.Uuid
  warehouseId String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Decimal   @default(0) @db.Decimal(14, 3)
  minStock    Decimal   @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime  @updatedAt

  @@id([productId, warehouseId])
}

// ───────── Cotizaciones y ventas ─────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  folio         Int         @unique @default(autoincrement())
  customerId    String      @db.Uuid
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId      String      @db.Uuid
  seller        User        @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  status        QuoteStatus @default(DRAFT)
  validUntil    DateTime
  currency      String      @default("MXN")
  notes         String?
  subtotal      Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(14, 2)
  total         Decimal     @default(0) @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         QuoteItem[]
  sale          Sale?

  @@index([sellerId, status])
  @@index([customerId])
}

/// Instantánea: no depende del catálogo después de creada.
model QuoteItem {
  id          String      @id @default(uuid()) @db.Uuid
  quoteId     String      @db.Uuid
  quote       Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?     @db.Uuid
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  position    Int
  sku         String
  description String
  line        ProductLine
  kind        ProductKind
  unit        String
  quantity    Decimal     @db.Decimal(14, 3)
  unitPrice   Decimal     @db.Decimal(14, 2)
  unitCost    Decimal     @db.Decimal(14, 4)
  discountPct Decimal     @default(0) @db.Decimal(5, 4)
  taxRate     Decimal     @db.Decimal(5, 4)
  subtotal    Decimal     @db.Decimal(14, 2)
  discount    Decimal     @db.Decimal(14, 2)
  tax         Decimal     @db.Decimal(14, 2)
  total       Decimal     @db.Decimal(14, 2)

  @@index([quoteId])
}

enum SaleStatus {
  CONFIRMED
  CANCELLED
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  folio         Int        @unique @default(autoincrement())
  quoteId       String     @unique @db.Uuid // impide convertir dos veces la misma cotización
  quote         Quote      @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customerId    String     @db.Uuid
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId      String     @db.Uuid
  seller        User       @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  warehouseId   String     @db.Uuid
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status        SaleStatus @default(CONFIRMED)
  subtotal      Decimal    @db.Decimal(14, 2)
  discountTotal Decimal    @db.Decimal(14, 2)
  taxTotal      Decimal    @db.Decimal(14, 2)
  total         Decimal    @db.Decimal(14, 2)
  confirmedAt   DateTime   @default(now())
  createdById   String     @db.Uuid
  items         SaleItem[]

  @@index([sellerId, confirmedAt])
}

model SaleItem {
  id          String      @id @default(uuid()) @db.Uuid
  saleId      String      @db.Uuid
  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?     @db.Uuid
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku         String
  description String
  line        ProductLine
  kind        ProductKind
  unit        String
  quantity    Decimal     @db.Decimal(14, 3)
  unitPrice   Decimal     @db.Decimal(14, 2)
  unitCost    Decimal     @db.Decimal(14, 4)
  discountPct Decimal     @db.Decimal(5, 4)
  taxRate     Decimal     @db.Decimal(5, 4)
  subtotal    Decimal     @db.Decimal(14, 2)
  discount    Decimal     @db.Decimal(14, 2)
  tax         Decimal     @db.Decimal(14, 2)
  total       Decimal     @db.Decimal(14, 2)

  @@index([saleId])
}

// ───────── Comisiones ─────────

/// Base de cálculo. COLLECTED requiere módulo de cobranza (no existe aún).
enum CommissionBasis {
  NET_SALES // subtotal - descuento, sin IVA
  MARGIN // (precio neto - costo) * cantidad
  COLLECTED
}

enum RuleSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Regla versionada: tasa "meta cumplida" vs "meta no cumplida" por línea.
model CommissionRuleSet {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  version       Int
  basis         CommissionBasis   @default(NET_SALES)
  status        RuleSetStatus     @default(DRAFT)
  notes         String?
  activatedById String?           @db.Uuid
  activatedAt   DateTime?
  createdAt     DateTime          @default(now())
  rates         CommissionRate[]
  entries       CommissionEntry[]

  @@unique([name, version])
}

model CommissionRate {
  id         String            @id @default(uuid()) @db.Uuid
  ruleSetId  String            @db.Uuid
  ruleSet    CommissionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  line       ProductLine
  rateMet    Decimal           @db.Decimal(6, 4)
  rateNotMet Decimal           @db.Decimal(6, 4)

  @@unique([ruleSetId, line])
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model CommissionPeriod {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  startDate DateTime          @db.Date
  endDate   DateTime          @db.Date
  status    PeriodStatus      @default(OPEN)
  createdAt DateTime          @default(now())
  targets   SalesTarget[]
  entries   CommissionEntry[]
}

/// Meta de venta (base de cálculo) por vendedor y periodo.
model SalesTarget {
  id       String           @id @default(uuid()) @db.Uuid
  periodId String           @db.Uuid
  period   CommissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sellerId String           @db.Uuid
  seller   User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  amount   Decimal          @db.Decimal(14, 2)

  @@unique([periodId, sellerId])
}

enum CommissionStatus {
  CALCULATED
  APPROVED
  PAID
}

model CommissionEntry {
  id           String            @id @default(uuid()) @db.Uuid
  periodId     String            @db.Uuid
  period       CommissionPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  sellerId     String            @db.Uuid
  seller       User              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  ruleSetId    String            @db.Uuid
  ruleSet      CommissionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  line         ProductLine
  baseAmount   Decimal           @db.Decimal(14, 2)
  sellerTotal  Decimal           @db.Decimal(14, 2) // base total del vendedor en el periodo
  targetAmount Decimal           @db.Decimal(14, 2)
  metTarget    Boolean
  rate         Decimal           @db.Decimal(6, 4)
  amount       Decimal           @db.Decimal(14, 2)
  status       CommissionStatus  @default(CALCULATED)
  approvedById String?           @db.Uuid
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime          @default(now())

  @@unique([periodId, sellerId, line])
}

// ───────── Aprobaciones y auditoría ─────────

model Approval {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String
  action      String
  decidedById String   @db.Uuid
  comment     String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
