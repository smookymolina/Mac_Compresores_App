# Copiar a .env y ajustar. No subir .env al repositorio.
DATABASE_URL="postgresql://mac:mac_dev_only@localhost:5433/mac_compresores?schema=public"
TEST_DATABASE_URL="postgresql://mac:mac_dev_only@localhost:5433/mac_compresores_test?schema=public"
# Usuario admin inicial creado por el seed (correo opcional; por defecto admin@maccompresores.local)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD="cambia-esta-clave"

# URL pública de la app (se usa en los enlaces de los correos). Ej.: https://maccompresores.app
APP_URL="http://localhost:3080"

# Correo saliente (recuperación de contraseña). Puerto 465 = TLS implícito; los certificados siempre se validan.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Mac Compresores"
SMTP_FROM_EMAIL=""
# Buzón para respuestas de clientes (por defecto, SMTP_FROM_EMAIL)
MAIL_REPLY_TO=""

# Trabajo diario (vencimientos, recordatorios, stock bajo, cobro vencido). Valor aleatorio de 32+ caracteres:
#   openssl rand -hex 32
CRON_SECRET=""
# Firma de enlaces públicos (WhatsApp) de cotizaciones y reportes; si falta se usa CRON_SECRET. openssl rand -hex 32
SHARE_SECRET=""
# Firma de los enlaces de descarga del APK de la app móvil (10 min). Obligatorio en producción. openssl rand -hex 32
APP_DOWNLOAD_SECRET=""
# Carpeta de los APK publicados (por omisión ./releases; en Docker /app/releases).
# MOBILE_RELEASES_DIR=""

# Datos bancarios del PDF de cotización: líneas separadas por "|". Vacío = no se imprime la sección.
# Ej.: BANK_INFO='Banco: BBVA|Titular: MAC Compresores SA de CV|Cuenta: 0123456789|CLABE: 012345678901234567'
BANK_INFO=""

# Respaldo diario de la BD en ./backups (servicio "backup"): días que se conservan.
BACKUP_KEEP_DAYS=14

# --- Portal de socios (v1.4.0) ---
# El portal vive en la ruta /socios del mismo dominio (sin subdominio): no hay variable de host.
# Firma de tokens/cookies del portal de socios. Aleatorio y exclusivo (no reutilizar otros secretos): openssl rand -hex 32
PARTNER_TOKEN_SECRET=
# Llave AES-256-GCM (64 hex = 32 bytes) que cifra los secretos TOTP en BD. openssl rand -hex 32
# ATENCION: si se pierde o cambia, todos los socios deben re-registrar su 2FA. Respaldarla fuera del servidor.
PARTNER_TOTP_KEY=
