# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/test-results
/playwright-report
/backups/

# Respaldos manuales de la BD (nunca subir)
backup_*.sql
respaldo_*.sql.gz
mobile/dist
# mobile/android y mobile/ios se versionan (sus salidas de build las ignoran mobile/android/.gitignore y mobile/ios/.gitignore).
mobile/ios/**/DerivedData/
mobile/ios/**/xcuserdata/
mobile/ios/App/build/
mobile/ios/App/Pods/
mobile/ios/App/App/public/
mobile/ios/**/.build/
*.ipa
*.xcarchive

# APK publicados de la app móvil (los sube el administrador; no se versionan)
/releases/
