// MAC Compresores — esquema relacional del MVP.
// Dinero: Decimal(14,2); costos y tasas con más precisión. Nunca Float.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Identidad y autorización ─────────

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // ADMIN | VENTAS | ALMACEN | GERENCIA
  name        String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique
  name           String
  passwordHash   String
  roleId         String               @db.Uuid
  role           Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  active         Boolean              @default(true)
  /// Invitado que aún no elige su contraseña (su passwordHash es aleatorio e inutilizable).
  invitePending  Boolean              @default(false)
  lastSeenAt     DateTime? // última actividad (se actualiza como máximo cada 5 min)
  /// Firma para correos (HTML). La carga un administrador desde Usuarios.
  signatureHtml  String?
  /// Bloque de asesor (PNG) que aparece en las cotizaciones de este usuario.
  quoteBlock     Bytes?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sessions       Session[]
  passwordResets PasswordResetToken[]
  notifications  Notification[]
  payments       Payment[]            @relation("PaymentCreatedBy")

  customers         Customer[]
  quotes            Quote[]             @relation("QuoteSeller")
  sales             Sale[]              @relation("SaleSeller")
  movements         InventoryMovement[]
  auditLogs         AuditLog[]
  commissionEntries CommissionEntry[]
  salesTargets      SalesTarget[]
}

model Session {
  id        String   @id // SHA-256 del token; el token en claro solo vive en la cookie
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Para qué sirve un enlace de un solo uso enviado por correo.
enum TokenPurpose {
  RESET // «Olvidé mi contraseña»
  INVITE // Invitación de usuario nuevo
}

/// Token de un solo uso (restablecer contraseña o activar invitación); el token en claro solo viaja en el correo.

model PasswordResetToken {
  id        String       @id // SHA-256 del token
  purpose   TokenPurpose @default(RESET)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
}

// ───────── Catálogo ─────────

/// Línea comercial: determina la tasa de comisión.
enum ProductLine {
  EQUIPO_VENTA // Venta de equipos nuevos o usados
  RENTA // Renta de equipos
  REFACCIONES // Filtros, separadores, drenes, lubricantes
  TUBERIA // Tubería e instalaciones neumáticas
  SERVICIOS // Servicios de pistón o tornillo
  KITS // Kits para compresores tipo tornillo
  VALVULAS_OTROS // Válvulas de seguridad, poleas, bandas, conexiones
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum Currency {
  MXN
  USD
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  products Product[]
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  sku           String        @unique
  oemName       String?
  oemPartNumber String?
  supplierCode  String? // "Item #" / "Air Supply Number"
  description   String
  categoryId    String?       @db.Uuid
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  line          ProductLine
  kind          ProductKind   @default(PRODUCT)
  unit          String        @default("PZA")
  cost          Decimal       @default(0) @db.Decimal(14, 4)
  markup        Decimal       @default(0) @db.Decimal(8, 4) // "Utilidad" (fracción)
  shipping      Decimal       @default(0) @db.Decimal(14, 2) // "Envío" / traslado
  consumables   Decimal       @default(0) @db.Decimal(14, 2) // Consumibles por unidad (según servicio)
  currency      Currency      @default(MXN) // Moneda de costo y precio; TUBERIA siempre USD
  price         Decimal       @default(0) @db.Decimal(14, 2)
  taxRate       Decimal       @default(0.16) @db.Decimal(5, 4)
  status        ProductStatus @default(ACTIVE)
  /// Texto normalizado (minúsculas, sin acentos) para búsqueda; lo mantiene un trigger en la BD.
  searchText    String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  priceHistory PriceHistory[]
  balances     StockBalance[]
  movements    InventoryMovement[]
  quoteItems   QuoteItem[]
  saleItems    SaleItem[]

  @@index([description])
  @@index([oemPartNumber])
  @@index([line])
}

/// Tipo de cambio USD→MXN capturado manualmente; se usa el más reciente.
model ExchangeRate {
  id          String   @id @default(uuid()) @db.Uuid
  rate        Decimal  @db.Decimal(10, 4)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PriceHistory {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cost        Decimal  @db.Decimal(14, 4)
  price       Decimal  @db.Decimal(14, 2)
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

// ───────── Clientes ─────────

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  legalName        String
  rfc              String?  @unique
  email            String?
  phone            String?
  paymentTermsDays Int      @default(0)
  creditLimit      Decimal? @db.Decimal(14, 2)
  notes            String?
  active           Boolean  @default(true)
  ownerId          String?  @db.Uuid // vendedor asignado
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts  CustomerContact[]
  addresses CustomerAddress[]
  quotes    Quote[]
  sales     Sale[]

  @@index([legalName])
  @@index([ownerId])
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  email      String?
  phone      String?
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Principal")
  street     String
  city       String?
  state      String?
  zip        String?
}

// ───────── Inventario ─────────

model Warehouse {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique
  name      String
  active    Boolean             @default(true)
  balances  StockBalance[]
  movements InventoryMovement[]
  sales     Sale[]
}

enum MovementType {
  IN
  OUT
  ADJUST
  SALE_OUT
  REVERSAL
}

/// Inmutable. Las correcciones se hacen con un movimiento REVERSAL que apunta al original.
model InventoryMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String       @db.Uuid
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  type        MovementType
  quantity    Decimal      @db.Decimal(14, 3) // con signo
  reason      String
  refType     String? // "SALE"
  refId       String?      @db.Uuid
  reversesId  String?      @unique @db.Uuid // a lo sumo una reversa por movimiento
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([productId, warehouseId, createdAt])
  @@index([refType, refId])
}

/// Saldo materializado; se actualiza en la misma transacción que el movimiento.
model StockBalance {
  productId   String    @db.Uuid
  warehouseId String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Decimal   @default(0) @db.Decimal(14, 3)
  minStock    Decimal   @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime  @updatedAt

  @@id([productId, warehouseId])
}

// ───────── Cotizaciones y ventas ─────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  folio         Int         @unique @default(autoincrement())
  customerId    String      @db.Uuid
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId      String      @db.Uuid
  seller        User        @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  status        QuoteStatus @default(DRAFT)
  validUntil    DateTime
  currency      String      @default("MXN")
  exchangeRate  Decimal?    @db.Decimal(10, 4) // TC USD→MXN usado en partidas en USD
  notes         String?
  deliveryTime  String? // Tiempo de entrega o de ejecución del servicio
  complements   Json? // Copia de los paquetes de complementos elegidos: [{code,name,activities[]}]
  warrantyMonths Int? // Garantía (cláusula D); null = texto genérico de 3 meses
  subtotal      Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(14, 2)
  total         Decimal     @default(0) @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         QuoteItem[]
  sale          Sale?

  @@index([sellerId, status])
  @@index([customerId])
}

/// Instantánea: no depende del catálogo después de creada.
model QuoteItem {
  id            String      @id @default(uuid()) @db.Uuid
  quoteId       String      @db.Uuid
  quote         Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId     String?     @db.Uuid
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  position      Int
  sku           String
  description   String
  details       String? // Actividades/alcance del servicio
  line          ProductLine
  kind          ProductKind
  unit          String
  quantity      Decimal     @db.Decimal(14, 3)
  unitPrice     Decimal     @db.Decimal(14, 2)
  unitCost      Decimal     @db.Decimal(14, 4)
  origCurrency  Currency    @default(MXN)
  origUnitPrice Decimal?    @db.Decimal(14, 4) // precio de lista en moneda original
  fxRate        Decimal     @default(1) @db.Decimal(10, 4)
  discountPct   Decimal     @default(0) @db.Decimal(5, 4)
  taxRate       Decimal     @db.Decimal(5, 4)
  subtotal      Decimal     @db.Decimal(14, 2)
  discount      Decimal     @db.Decimal(14, 2)
  tax           Decimal     @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)

  @@index([quoteId])
}

enum SaleStatus {
  CONFIRMED
  CANCELLED
}

model Sale {
  id            String            @id @default(uuid()) @db.Uuid
  folio         Int               @unique @default(autoincrement())
  quoteId       String            @unique @db.Uuid // impide convertir dos veces la misma cotización
  quote         Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customerId    String            @db.Uuid
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId      String            @db.Uuid
  seller        User              @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  warehouseId   String            @db.Uuid
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status        SaleStatus        @default(CONFIRMED)
  subtotal      Decimal           @db.Decimal(14, 2)
  discountTotal Decimal           @db.Decimal(14, 2)
  taxTotal      Decimal           @db.Decimal(14, 2)
  total         Decimal           @db.Decimal(14, 2)
  expenses      Decimal           @default(0) @db.Decimal(14, 2) // Gastos adicionales (restan a la utilidad comisionable)
  confirmedAt   DateTime          @default(now())
  createdById   String            @db.Uuid
  items         SaleItem[]
  payments      Payment[]
  commissions   CommissionEntry[]

  @@index([sellerId, confirmedAt])
}

// ───────── Cobranza ─────────

enum PaymentMethod {
  TRANSFER
  CASH
  CARD
  CHECK
  OTHER
}

/// Pago recibido de una venta. Inmutable: una corrección se registra anulándolo (voidedAt) con motivo.
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  saleId      String        @db.Uuid
  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(14, 2)
  paidAt      DateTime      @db.Date
  method      PaymentMethod
  reference   String?
  createdById String        @db.Uuid
  createdBy   User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  voidedAt    DateTime?
  voidedById  String?       @db.Uuid
  voidReason  String?

  @@index([saleId])
  @@index([paidAt])
}

model SaleItem {
  id            String      @id @default(uuid()) @db.Uuid
  saleId        String      @db.Uuid
  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String?     @db.Uuid
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku           String
  description   String
  details       String? // Actividades/alcance del servicio
  line          ProductLine
  kind          ProductKind
  unit          String
  quantity      Decimal     @db.Decimal(14, 3)
  unitPrice     Decimal     @db.Decimal(14, 2)
  unitCost      Decimal     @db.Decimal(14, 4)
  origCurrency  Currency    @default(MXN)
  origUnitPrice Decimal?    @db.Decimal(14, 4) // precio de lista en moneda original
  fxRate        Decimal     @default(1) @db.Decimal(10, 4)
  discountPct   Decimal     @db.Decimal(5, 4)
  taxRate       Decimal     @db.Decimal(5, 4)
  subtotal      Decimal     @db.Decimal(14, 2)
  discount      Decimal     @db.Decimal(14, 2)
  tax           Decimal     @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)

  @@index([saleId])
}

// ───────── Comisiones ─────────

/// Base de cálculo. COLLECTED requiere módulo de cobranza (no existe aún).
enum CommissionBasis {
  NET_SALES // subtotal - descuento, sin IVA
  MARGIN // (precio neto - costo) * cantidad
  COLLECTED
}

enum RuleSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Regla versionada: tasa "meta cumplida" vs "meta no cumplida" por línea.
model CommissionRuleSet {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  version       Int
  basis         CommissionBasis   @default(NET_SALES)
  status        RuleSetStatus     @default(DRAFT)
  notes         String?
  activatedById String?           @db.Uuid
  activatedAt   DateTime?
  createdAt     DateTime          @default(now())
  rates         CommissionRate[]
  entries       CommissionEntry[]

  @@unique([name, version])
}

model CommissionRate {
  id         String            @id @default(uuid()) @db.Uuid
  ruleSetId  String            @db.Uuid
  ruleSet    CommissionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  line       ProductLine
  rateMet    Decimal           @db.Decimal(6, 4)
  rateNotMet Decimal           @db.Decimal(6, 4)

  @@unique([ruleSetId, line])
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model CommissionPeriod {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  startDate DateTime          @db.Date
  endDate   DateTime          @db.Date
  status    PeriodStatus      @default(OPEN)
  createdAt DateTime          @default(now())
  targets   SalesTarget[]
  entries   CommissionEntry[]
}

/// Meta de venta (base de cálculo) por vendedor y periodo.
model SalesTarget {
  id       String           @id @default(uuid()) @db.Uuid
  periodId String           @db.Uuid
  period   CommissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sellerId String           @db.Uuid
  seller   User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  amount   Decimal          @db.Decimal(14, 2)

  @@unique([periodId, sellerId])
}

enum CommissionStatus {
  CALCULATED
  APPROVED
  PAID
}

model CommissionEntry {
  id           String            @id @default(uuid()) @db.Uuid
  periodId     String            @db.Uuid
  period       CommissionPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  sellerId     String            @db.Uuid
  seller       User              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  ruleSetId    String            @db.Uuid
  ruleSet      CommissionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  saleId       String?           @db.Uuid
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  collectedAt  DateTime?         @db.Date // fecha en que la venta quedó cobrada al 100%
  line         ProductLine
  baseAmount   Decimal           @db.Decimal(14, 2)
  sellerTotal  Decimal           @db.Decimal(14, 2) // venta total (O.C.) del vendedor en el mes de la O.C.
  targetAmount Decimal           @db.Decimal(14, 2) // meta del mes de la O.C.
  metTarget    Boolean // meta del mes de la O.C. (define % alto/bajo aunque se cobre después)
  rate         Decimal           @db.Decimal(6, 4)
  amount       Decimal           @db.Decimal(14, 2)
  status       CommissionStatus  @default(CALCULATED)
  approvedById String?           @db.Uuid
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime          @default(now())

  @@unique([periodId, saleId, line])
  @@index([saleId])
}

// ───────── Notificaciones y límites ─────────

/// Aviso dentro de la app. dedupeKey evita repetir el mismo aviso (p. ej. el trabajo diario).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  href      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Contador de intentos por clave (login, recuperación) compartido entre instancias y reinicios.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ───────── Aprobaciones y auditoría ─────────

model Approval {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String
  action      String
  decidedById String   @db.Uuid
  comment     String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Paquetes de complementos (alcance incluido) que se adjuntan a las cotizaciones.
model ComplementPackage {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  activities     String[]
  warrantyMonths Int      @default(3)
  skuPatterns    String[] // comodines sobre SKU o descripción ("8000-*", "Renta *"); sugieren el paquete al cotizar
  active         Boolean  @default(true)
  shared         Boolean  @default(true) // false = solo lo ve y usa el administrador
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
